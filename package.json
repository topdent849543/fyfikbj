{
  "name": "topdent-platform",
  "version": "1.0.0",
  "description": "TopDent - Professional E-commerce Platform for Dental Tools & Products",
  "private": true,
  "scripts": {
    "install-all": "npm ci && npm --prefix server ci && npm --prefix client ci",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --prefix server run check",
    "build:client": "npm --prefix client run build",
    "start": "npm run start:server",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "npm --prefix client run lint",
    "check": "npm --prefix server run check && npm --prefix client run lint",
    "test": "npm --prefix server test",
    "migrate": "npm --prefix server run migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "ecommerce",
    "dental",
    "tools",
    "products",
    "nextjs",
    "nodejs",
    "supabase",
    "railway"
  ],
  "author": "TopDent Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
