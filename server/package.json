{
  "name": "topdent-backend",
  "version": "1.0.0",
  "description": "TopDent E-commerce Platform Backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "check": "node --check src/index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.3.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^20.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "sharp": "^0.34.5",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "pg-mem": "^3.0.14"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
