{
  "expo": {
    "name": "TopDent",
    "slug": "topdent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "topdent",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#0f766e" },
    "android": {
      "package": "com.topdent.app",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#0f766e" },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "plugins": ["expo-image-picker"],
    "extra": { "apiUrl": "https://fyfikbj-production.up.railway.app/api" }
  }
}
