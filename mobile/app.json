{
  "expo": {
    "name": "TopDent",
    "slug": "topdent",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "topdent",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0f766e"
    },
    "android": {
      "package": "com.topdent.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://fyfikbj-production.up.railway.app/api"
    }
  }
}
