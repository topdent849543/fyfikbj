# Runtime
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# Supabase (required by the backend; never expose SERVICE_KEY to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=topdent-media

# Security (required, 32+ random characters; no development fallback exists)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3001

# Client (set in the client deployment environment, not committed to source)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# SMTP (optional; password-reset endpoint returns a safe configuration error until supplied)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=TopDent <noreply@example.com>

# Administrator bootstrap (use only for npm --prefix server run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=TopDent Admin
