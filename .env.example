# Backend Configuration
PORT=3000
NODE_ENV=production

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# Supabase PostgreSQL connection string; required only by `npm run migrate`
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true

# Security (JWT_SECRET must be at least 32 characters in production)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:3001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@topdent.com

# Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Redis (Optional for caching)
REDIS_URL=redis://localhost:6379

# Environment
APP_NAME=TopDent
APP_URL=http://localhost:3000
